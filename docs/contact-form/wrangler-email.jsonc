{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stacked",
  "compatibility_date": "2026-09-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "src/contact.mjs",
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "ryan@popbia.com"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
